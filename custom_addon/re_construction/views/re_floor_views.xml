<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_floor_list" model="ir.ui.view">
        <field name="name">re.floor.list</field>
        <field name="model">re.floor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="building_id"/>
            </list>
        </field>
    </record>

    <record id="view_re_floor_form" model="ir.ui.view">
        <field name="name">re.floor.form</field>
        <field name="model">re.floor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="building_id"/>
                    </group>
                    <notebook>
                        <page string="Units">
                            <field name="unit_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="property_type"/>
                                    <field name="area"/>
                                    <field name="selling_price"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_floor" model="ir.actions.act_window">
        <field name="name">Floors</field>
        <field name="res_model">re.floor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
