<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_payment_plan_list" model="ir.ui.view">
        <field name="name">re.payment.plan.list</field>
        <field name="model">re.payment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="total_percentage"/>
            </list>
        </field>
    </record>

    <record id="view_re_payment_plan_form" model="ir.ui.view">
        <field name="name">re.payment.plan.form</field>
        <field name="model">re.payment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="total_percentage" readonly="1"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="construction_stage"/>
                            <field name="percentage"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">re.payment.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
