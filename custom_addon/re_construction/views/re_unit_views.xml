<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_re_unit_list" model="ir.ui.view">
        <field name="name">re.unit.list</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="building_id"/>
                <field name="floor_id"/>
                <field name="property_type"/>
                <field name="area"/>
                <field name="selling_price"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state in ('reserved','booked')"
                       decoration-info="state == 'sold'"
                       decoration-muted="state in ('cancelled','maintenance')"/>
            </list>
        </field>
    </record>

    <record id="view_re_unit_search" model="ir.ui.view">
        <field name="name">re.unit.search</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="building_id"/>
                <field name="floor_id"/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Booked" name="booked" domain="[('state','=','booked')]"/>
                <filter string="Sold" name="sold" domain="[('state','=','sold')]"/>
                <group expand="0" string="Group By">
                    <filter string="Building" name="group_building" context="{'group_by':'building_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_re_unit_form" model="ir.ui.view">
        <field name="name">re.unit.form</field>
        <field name="model">re.unit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,reserved,booked,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="floor_id"/>
                            <field name="building_id" readonly="1"/>
                            <field name="land_id" readonly="1"/>
                            <field name="project_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="property_type"/>
                            <field name="area"/>
                            <field name="selling_price"/>
                            <field name="product_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_re_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">re.unit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
